{
  "name": "@dataemergencia/emergency",
  "version": "0.1.0",
  "description": "Framework-agnostic emergency client for DataEmergencia, with a mountable React panel and an IIFE build.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./iife": {
      "types": "./dist/index.d.ts",
      "default": "./dist/iife/emergency.iife.global.js"
    }
  },
  "unpkg": "./dist/iife/emergency.iife.global.js",
  "jsdelivr": "./dist/iife/emergency.iife.global.js",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-BoxHead-Guy/emergency.git"
  },
  "bugs": {
    "url": "https://github.com/The-BoxHead-Guy/emergency/issues"
  },
  "homepage": "https://github.com/The-BoxHead-Guy/emergency#readme",
  "keywords": [
    "dataemergencia",
    "emergency",
    "sos",
    "react",
    "sdk"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm run example:vanilla",
    "build": "vp pack && node scripts/inject-iife-styles.mjs",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "pack": "npm pack --dry-run",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check && pnpm run test",
    "example:vanilla": "pnpm run build && node examples/vanilla/copy-iife.mjs && vp dev",
    "example:vanilla:mock": "node examples/vanilla/mock-bff.mjs",
    "lab": "vp dev",
    "release": "bash ./scripts/release.sh",
    "split": "bash ./scripts/split.sh"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "pusher-js": "^8.6.0",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "~22.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  }
}
